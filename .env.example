# Copie para .env (na raiz do repositório) e ajuste.
# Nunca coloque segredos reais neste arquivo de exemplo nem no repositório.

# development | test | staging | production
APP_ENV=development

# Banco local. O script `npm run db:start` sobe um PostgreSQL 18 embarcado
# escutando apenas em 127.0.0.1, com a senha definida em DEV_DB_PASSWORD.
# Em Docker, use as mesmas URLs apontando para o serviço `postgres`.
DEV_DB_PORT=5433
DEV_DB_PASSWORD=troque-esta-senha-local
DATABASE_URL=postgres://oralis:troque-esta-senha-local@127.0.0.1:5433/oralis_dev
DATABASE_URL_TEST=postgres://oralis:troque-esta-senha-local@127.0.0.1:5433/oralis_test

# API (NestJS)
API_PORT=4000
# Origem do front-end. A API só aceita requisições mutáveis desta origem.
WEB_ORIGIN=http://localhost:3000
# true em qualquer ambiente servido por HTTPS
SESSION_COOKIE_SECURE=false

# Front-end (Next.js): para onde o proxy /api/* encaminha as chamadas
API_INTERNAL_URL=http://127.0.0.1:4000

# Seed de demonstração (opcional). Se vazio, uma senha aleatória é gerada
# e exibida uma única vez no terminal.
SEED_DEMO_PASSWORD=

# Chave AES-256-GCM (32 bytes em base64) para segredos de MFA e dados cifrados.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# E-mail. Vazio = caixa de saída local (apenas fora de produção).
# Ex.: smtps://usuario:senha@smtp.provedor.com:465
SMTP_URL=
MAIL_FROM=Oralis Cloud <nao-responda@oralis.example>

# SMS / WhatsApp (Twilio). Sem credenciais, os canais ficam não configurados.
# Remetentes em E.164, sem prefixo whatsapp:. Veja docs/MESSAGING.md.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TWILIO_TIMEOUT_MS=10000
# JSON: UUID da versão do modelo local -> ContentSid aprovado + mapa de variáveis.
TWILIO_WHATSAPP_TEMPLATES={}

# Documentos privados (caminho relativo à raiz do projeto ou absoluto)
# Arquivos (documentos, radiografias). local = pasta privada no disco (só desenvolvimento).
# Em produção é obrigatório STORAGE_DRIVER=s3 com um bucket PRIVADO (sem acesso público).
STORAGE_DRIVER=local
STORAGE_DIR=.data/uploads
S3_BUCKET=
S3_REGION=sa-east-1
# Só para provedores compatíveis (ex.: Cloudflare R2). Vazio = AWS S3.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Hospedagem da API. Em contêiner: API_HOST=0.0.0.0 (o provedor define PORT).
API_HOST=127.0.0.1
# Proxies confiáveis à frente da API: 'loopback' local; Vercel -> Railway/Render: 2.
TRUST_PROXY=loopback
DATABASE_POOL_MAX=10
JOBS_ENABLED=true

# Integrações opcionais; mantenha vazias se não configuradas
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ANTHROPIC_API_KEY=

# Backup: pasta com pg_dump e pg_restore compatíveis com PostgreSQL 18
PG_BIN=
# Somente para ensaio em banco NOVO com prefixo oralis_restore_
RESTORE_DATABASE_URL=
